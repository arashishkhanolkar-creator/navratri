# Copy this file to .env.local and fill in your own values.

# Your deployed site URL, used for sitemap/metadata. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX). Leave blank to disable.
NEXT_PUBLIC_GA_ID=

# Google AdSense publisher ID (e.g. ca-pub-XXXXXXXXXXXXXXXX). Leave blank to disable.
NEXT_PUBLIC_ADSENSE_CLIENT=
